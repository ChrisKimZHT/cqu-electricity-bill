# ==================== 账号与宿舍 ====================
# 统一认证后，从 sessionStorage 的 access_token 取得值，令牌过期后需要重新获取。
SYNJONES_AUTH=
# 校区：huxi（虎溪，项目 448）或 shapingba（沙坪坝，项目 449）。
CQU_CAMPUS=huxi
# 填写房号，例如 D1102（虎溪）或 A1S123（沙坪坝）。
CQU_ROOM=D1102
# 网页显示的楼栋名称。虎溪可留空；沙坪坝通常留空，无法自动定位时填写实际楼栋名称。
CQU_BUILDING=兰园1栋
# 虎溪补助电量折算为金额时使用的电价（元/度）；沙坪坝接口直接返回补贴金额。
ELECTRICITY_PRICE=0.54

# ==================== 定时任务 ====================
# 每天抓取一次，使用 24 小时制 HH:MM（00:00～23:59）。
SCHEDULE_TIME=12:00
# 调度和数据记录使用的 IANA 时区。
TIMEZONE=Asia/Shanghai

# ==================== 邮件通知 ====================
# true：daemon 按邮件计划发送；false：不启用定时邮件。
EMAIL_ENABLED=false
# 邮件计划，格式为 HH:MM@星期，多个星期用英文逗号分隔。
# 1～6 表示周一至周六，0、7 均表示周日；示例表示周六周日 14:00 发送。
EMAIL_SCHEDULE=14:00@6,7
# 每次抓取后余额低于阈值时立即发邮件，独立于 EMAIL_ENABLED；需配置下方 SMTP。
BALANCE_WARNING_ENABLED=false
# 余额警告阈值（元），按包含补助的合计余额判断，严格小于时发送。
BALANCE_WARNING_THRESHOLD=10
# SMTP 服务器地址。
SMTP_HOST=smtp.example.com
# SMTP 端口；SSL 通常使用 465，STARTTLS 通常使用 587。
SMTP_PORT=465
# SMTP 登录用户名，通常为完整邮箱地址。
SMTP_USERNAME=your_email@example.com
# SMTP 密码或邮箱服务商生成的授权码。
SMTP_PASSWORD=your_smtp_authorization_code
# 发件人地址，通常与 SMTP_USERNAME 相同。
SMTP_FROM=your_email@example.com
# 收件人地址，多个地址以英文逗号分隔。
SMTP_TO=recipient@example.com
# 是否建立 SMTP SSL 连接；使用 465 端口时通常设为 true。
SMTP_USE_SSL=true
# 是否在普通连接上启用 STARTTLS；使用 587 端口时设为 true，并将 SMTP_USE_SSL 设为 false。
SMTP_STARTTLS=false
# SMTP 连接和发送超时，单位为秒。
SMTP_TIMEOUT=20
# 邮件标题前缀。
EMAIL_SUBJECT_PREFIX=电费监控

# ==================== 数据与日志 ====================
# history.csv、history.png 和日志相关文件的保存目录；DOCKER_MODE=true 时固定为 /data，忽略此项。
DATA_DIR=.
# Loguru 日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
LOG_LEVEL=INFO

# ==================== 网络与重试 ====================
# 单次 HTTP 请求超时，单位为秒。
REQUEST_TIMEOUT=20
